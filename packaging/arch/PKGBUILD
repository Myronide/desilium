# Maintainer: Myronide <maintainers@example.invalid>  # set before publishing
#
# Builds the Desilium workspace in release mode and installs it with packaging/install.sh.
# The source tarball is a placeholder: replace it with the release archive (or a git source)
# before publishing, then run updpkgsums to fill in the checksum.

pkgname=desilium
pkgver=0.1.0
pkgrel=1
pkgdesc="Premium Wayland desktop environment on KWin (shell, settings, file manager and session)"
arch=('x86_64')
url="https://example.invalid/desilium"  # project URL: set before publishing
license=('MIT')
depends=(
  'wayland'
  'libxkbcommon'
  'fontconfig'
  'glib2'
  'dbus'
  'kwin'            # the compositor and window manager: kwin_wayland
  'kglobalacceld'   # global shortcuts, D-Bus activated by KWin and the bridge
  'kconfig'         # kwriteconfig6, used by desilium-kwin
  'breeze-icons'    # KDE's default icon theme; applications' icons are resolved through it
  'xorg-xwayland'   # X11 applications, started by KWin
  'xdg-desktop-portal-kde'  # screen casting, remote desktop and screenshots on KWin
  'kitty'
  'inter-font'      # default UI typeface
)
optdepends=(
  'gvfs: device and network locations for Doria'
  'gvfs-smb: SMB shares in Doria'
  'networkmanager: Wi-Fi quick settings'
  'wireplumber: volume and microphone controls'
  'bluez-utils: Bluetooth quick settings'
  'brightnessctl: screen brightness controls'
  'power-profiles-daemon: energy profiles'
  'xdg-desktop-portal-gtk: file chooser and settings portal backend used by packaging/xdg-desktop-portal'
  'breeze: window decorations and style that KWin and Qt applications use by default'
)
makedepends=(
  'cargo'           # rust toolchain; rust-toolchain.toml selects the channel
  'pkgconf'         # locates the native libraries used by the -sys crates
)
source=("$pkgname-$pkgver.tar.gz::https://example.invalid/releases/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked \
    -p desilium-kwin \
    -p desilium-session \
    -p desilium-shell \
    -p desilium-settings \
    -p desilium-notifications \
    -p desilium-files
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo test --release --locked -p desilium-session
}

package() {
  cd "$pkgname-$pkgver"
  # install.sh reads binaries from ${CARGO_TARGET_DIR}/release and honours DESTDIR.
  CARGO_TARGET_DIR="$PWD/target" DESTDIR="$pkgdir" \
    ./packaging/install.sh --prefix /usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
