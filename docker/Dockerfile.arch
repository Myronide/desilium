# syntax=docker/dockerfile:1
# Arch Linux variant of docker/Dockerfile: the same binaries on a pacman-based runtime, with
# KWin and the NetworkManager, audio and brightness tools the quick settings talk to.
# Run via `scripts/docker-run.sh --arch`. This image has not been built since the move to KWin
# (and not in the authoring environment); the package names are from memory, check them with
# `pacman -Ss` first.
#
# Structurally identical to docker/Dockerfile, .ubuntu and .fedora (user `dev`, /home/dev skeleton
# from docker/home-skel, same ENTRYPOINT and CMD); only the package manager lines differ, plus
# the Arch-only extras (AUR helpers, sudo, base-devel, Firefox sandbox switches).
# Needs BuildKit (COPY --chmod / --chown with build arguments).

ARG BUILD_IMAGE=archlinux:base-devel
ARG RUNTIME_IMAGE=archlinux:base

# ---------------------------------------------------------------------------
# Builder
# ---------------------------------------------------------------------------
FROM ${BUILD_IMAGE} AS builder

RUN pacman -Syu --noconfirm --needed \
        rust \
        pkgconf \
        wayland \
        libxkbcommon \
        glib2 \
        fontconfig \
    && pacman -Scc --noconfirm

WORKDIR /src
COPY . .

# The `rust` package ships the stable toolchain without rustup, so rust-toolchain.toml is ignored.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/src/target \
    set -eux; \
    cargo build --release --locked \
        -p desilium-session -p desilium-kwin -p desilium-shell \
        -p desilium-notifications -p desilium-settings -p desilium-files; \
    cp target/release/desilium-session target/release/desilium-kwin \
       target/release/desilium-shell target/release/desilium-notifications \
       target/release/desilium-settings target/release/doria /usr/local/bin/

# ---------------------------------------------------------------------------
# AUR helpers: yay-bin and paru-bin, built as packages (makepkg refuses to run as root)
# ---------------------------------------------------------------------------
FROM ${BUILD_IMAGE} AS aur

RUN pacman -Syu --noconfirm --needed git sudo \
    && useradd --create-home builder \
    && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder
USER builder
WORKDIR /home/builder
# yay-bin ships a static release binary. paru-bin does not: it links against a fixed libalpm
# soname and breaks whenever Arch moves to a newer pacman, so paru is built from source here
# (a few minutes, pulls in rust as a build dependency) against the libalpm of this image.
RUN set -eux; \
    for helper in yay-bin paru; do \
        git clone --depth 1 "https://aur.archlinux.org/${helper}.git"; \
        (cd "${helper}" && makepkg --syncdeps --noconfirm --cleanbuild); \
    done; \
    mkdir /home/builder/pkgs; \
    find yay-bin paru -maxdepth 1 -name '*.pkg.tar.zst' ! -name '*-debug-*' \
        -exec cp {} /home/builder/pkgs/ \;

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS runtime

# networkmanager provides nmcli (Wi-Fi and Ethernet status); iproute2 and iw help with diagnosis
# inside the container. Without a Wi-Fi radio the Wi-Fi tile reports "Unavailable", which is the
# intended behavior on a headless test host.
RUN pacman -Syu --noconfirm --needed \
        wayland \
        libxkbcommon \
        xkeyboard-config \
        mesa \
        kwin \
        kglobalacceld \
        kconfig \
        xorg-xwayland \
        dbus \
        breeze \
        fontconfig \
        glib2 \
        gvfs \
        kitty \
        foot \
        inter-font \
        ttf-dejavu \
        hicolor-icon-theme \
        networkmanager \
        iproute2 \
        iw \
        wireplumber \
        brightnessctl \
        bluez-utils \
        sudo \
        base-devel \
        git \
        curl \
        wget \
        nano \
        vim \
        less \
        man-db \
        rsync \
        openssh \
        unzip \
        zip \
        htop \
        fastfetch \
        pacman-contrib \
        reflector \
    && pacman -Scc --noconfirm

# AUR helpers for installing AUR packages (`yay -S librewolf-bin`, `paru -S ...`). Building needs
# the network (`--net`) and, like pacman, sudo (the default for `--arch`).
COPY --from=aur /home/builder/pkgs/ /tmp/aur-pkgs/
RUN pacman -U --noconfirm /tmp/aur-pkgs/*.pkg.tar.zst \
    && rm -rf /tmp/aur-pkgs \
    && yay --version && paru --version

# The test user may use sudo without a password (throwaway image, no secrets inside). Plain
# `docker-run.sh --arch` starts the container so that it works; with `--no-sudo`
# no-new-privileges and dropped capabilities stop setuid binaries again.
ARG USER_NAME=dev
ARG USER_UID=1000
ARG USER_GID=1000
ARG USER_HOME=/home/${USER_NAME}

RUN groupadd --gid ${USER_GID} ${USER_NAME} \
    && useradd --uid ${USER_UID} --gid ${USER_GID} --groups wheel --create-home --home-dir ${USER_HOME} \
        --shell /bin/bash ${USER_NAME} \
    && echo "${USER_NAME} ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/10-${USER_NAME} \
    && chmod 0440 /etc/sudoers.d/10-${USER_NAME} \
    && visudo -c

# D-Bus (and with it Firefox, GTK, portals) wants a machine id; the pacman image ships none.
RUN dbus-uuidgen --ensure=/etc/machine-id

COPY --from=builder /usr/local/bin/desilium-session /usr/local/bin/desilium-session
COPY --from=builder /usr/local/bin/desilium-kwin /usr/local/bin/desilium-kwin
COPY --from=builder /usr/local/bin/desilium-shell /usr/local/bin/desilium-shell
COPY --from=builder /usr/local/bin/desilium-notifications /usr/local/bin/desilium-notifications
COPY --from=builder /usr/local/bin/desilium-settings /usr/local/bin/desilium-settings
COPY --from=builder /usr/local/bin/doria /usr/local/bin/doria
COPY packaging/applications/org.desilium.Shell.desktop /usr/share/applications/org.desilium.Shell.desktop
COPY assets/wallpapers /usr/share/desilium/wallpapers
COPY packaging/applications/org.desilium.Doria.desktop /usr/share/applications/org.desilium.Doria.desktop
COPY packaging/icons/org.desilium.Doria.svg /usr/share/icons/hicolor/scalable/apps/org.desilium.Doria.svg
COPY packaging/icons/desilium-settings.svg /usr/share/icons/hicolor/scalable/apps/desilium-settings.svg
COPY packaging/applications/desilium-settings.desktop /usr/share/applications/desilium-settings.desktop
COPY assets/demo-apps /usr/share/desilium-demo

# The seeded user space: the skeleton from docker/home-skel (XDG user folders, user-dirs.dirs,
# Documents/Welcome.txt), the bundled wallpapers and executable launchers on the desktop (Desilium
# only starts launchers that have the executable bit). scripts/docker-run.sh mounts a named volume
# at the home; Docker fills a new volume from this content once, including ownership.
COPY --chown=${USER_UID}:${USER_GID} docker/home-skel/ ${USER_HOME}/
RUN find ${USER_HOME} -name .gitkeep -type f -delete
COPY --chown=${USER_UID}:${USER_GID} assets/wallpapers/ ${USER_HOME}/Pictures/Wallpapers/
COPY --chown=${USER_UID}:${USER_GID} --chmod=0755 packaging/applications/org.desilium.Doria.desktop ${USER_HOME}/Desktop/org.desilium.Doria.desktop
COPY --chown=${USER_UID}:${USER_GID} --chmod=0755 packaging/applications/desilium-settings.desktop ${USER_HOME}/Desktop/desilium-settings.desktop

# The XDG directories are the defaults below $HOME (a Docker volume, see scripts/docker-run.sh).
# Docker's default seccomp profile forbids the user namespaces Firefox's own sandbox needs
# (`clone() failure: EPERM`, then the content process dies). The container is the sandbox here,
# so the browser sandboxes are off instead of loosening seccomp for the whole container.
ENV LANG=C.UTF-8 \
    HOME=${USER_HOME} \
    MOZ_DISABLE_CONTENT_SANDBOX=1 \
    MOZ_DISABLE_GMP_SANDBOX=1 \
    MOZ_DISABLE_RDD_SANDBOX=1 \
    MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1 \
    MOZ_DISABLE_GPU_SANDBOX=1

USER ${USER_UID}:${USER_GID}
WORKDIR ${USER_HOME}

# The session runs KWin nested in the host session. --allow-any-client: the shell is in
# /usr/local/bin here, and the container is the sandbox, so KWin's per-executable permission
# check is switched off.
ENTRYPOINT ["desilium-session"]
CMD ["--allow-any-client"]
